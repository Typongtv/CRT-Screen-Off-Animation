SECTION 5: SYSTEM GRAPHICS PROCESSING SUB-SYSTEM (CrtShaderPipeline.kt)
================================================================================
package com.retro.crteffect

import android.graphics.RuntimeShader
import android.os.Build
import androidx.annotation.RequiresApi
import androidx.compose.animation.core.Animatable
import androidx.compose.animation.core.CubicBezierEasing
import androidx.compose.animation.core.tween
import androidx.compose.foundation.Canvas
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.runtime.Composable
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import androidx.compose.ui.geometry.Offset
import androidx.compose.ui.geometry.Size
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.asComposeRenderEffect
import androidx.compose.ui.graphics.graphicsLayer
import kotlinx.coroutines.launch

/**
 * AGSL (Android Graphics Shading Language) Hardware Accelerated Pipeline Matrix
 * Coordinates mathematical physics structures matching real analog magnetic coil collapse.
 */
const val CRT_PHYSICS_SHADER = """
    uniform shader content;
    uniform vec2 resolution;
    uniform float progress;      
    uniform float powerFlash;    
    
    vec4 main(vec2 coords) {
        vec2 uv = (coords / resolution) * 2.0 - 1.0;
        
        // 1. Pincushion Implosion Physics Dynamics
        // Curves coordinates progressingly inside an inverted spherical field spectrum
        float distortFactor = 1.0 + progress * 8.0; 
        uv.y /= max(1.0 - progress * 1.04, 0.001); 
        uv.x *= 1.0 + (uv.y * uv.y) * 0.18 * (1.0 + progress * 4.0);
        
        vec2 uvDistorted = (uv + 1.0) / 2.0;
        
        // Isolate glass boundaries out into a pure dark vacuum void
        if (uvDistorted.x < 0.0 || uvDistorted.x > 1.0 || uvDistorted.y < 0.0 || uvDistorted.y > 1.0) {
            return vec4(0.0, 0.0, 0.0, 1.0);
        }
        
        // 2. Chromatic Aberration Spectrum Mapping
        // Tears color alignments sideways simulating un-shielded tube distortion
        float aberration = 0.022 * progress;
        vec2 uvRed   = vec2(uvDistorted.x - aberration, uvDistorted.y);
        vec2 uvGreen = uvDistorted;
        vec2 uvBlue  = vec2(uvDistorted.x + aberration, uvDistorted.y);
        
        float r = content.eval(clamp(uvRed * resolution, vec2(0.0), resolution)).r;
        float g = content.eval(clamp(uvGreen * resolution, vec2(0.0), resolution)).g;
        float b = content.eval(clamp(uvBlue * resolution, vec2(0.0), resolution)).b;
        
        vec4 color = vec4(r, g, b, 1.0);
        
        // 3. High Voltage Overexposure Surge Simulation
        color.rgb += vec3(powerFlash * 0.95);
        
        return color;
    }
"""

@RequiresApi(Build.VERSION_CODES.TIRAMISU)
@Composable
fun AuthenticCrtDisplayContainer(
    isTriggered: Boolean,
    modifier: Modifier = Modifier,
    onAnimationComplete: () -> Unit,
    content: @Composable () -> Unit
) {
    val shutdownProgress = remember { Animatable(0f) }
    val powerFlash = remember { Animatable(0f) }
    val phosphorAlpha = remember { Animatable(0f) }
    val phosphorDotWidth = remember { Animatable(1f) }

    LaunchedEffect(isTriggered) {
        if (isTriggered) {
            // Stage 1: Ignite massive voltage flash surge across phosphors
            launch {
                powerFlash.animateTo(
                    targetValue = 1.0f,
                    animationSpec = tween(durationMillis = 80, easing = CubicBezierEasing(0f, 1f, 0.3f, 1f))
                )
            }
            // Stage 2: Collapse magnetic deflection vertical fields
            shutdownProgress.animateTo(
                targetValue = 1.0f,
                animationSpec = tween(durationMillis = 240, easing = CubicBezierEasing(0.7f, 0f, 0.8f, 0.3f))
            )
            // Stage 3: Terminate UI matrix projection; initialize glass thermal cooling data
            launch {
                phosphorAlpha.snapTo(1f)
                powerFlash.snapTo(0f)
            }
            // Stage 4: Snap remaining horizontal line trace down into a core central target point
            phosphorDotWidth.animateTo(
                targetValue = 0f,
                animationSpec = tween(durationMillis = 160, easing = CubicBezierEasing(0.1f, 0.8f, 0.2f, 1f))
            )
            // Stage 5: Slowly bleed off thermodynamic charge across the glass faceplate
            phosphorAlpha.animateTo(
                targetValue = 0f,
                animationSpec = tween(durationMillis = 650, easing = CubicBezierEasing(0.2f, 0f, 0.8f, 0.2f))
            )
            onAnimationComplete()
        }
    }

    Box(modifier = modifier.fillMaxSize().background(Color(0xFF020202))) {
        Box(
            modifier = Modifier
                .fillMaxSize()
                .graphicsLayer {
                    val shader = RuntimeShader(CRT_PHYSICS_SHADER)
                    shader.setFloatUniform("progress", shutdownProgress.value)
                    shader.setFloatUniform("powerFlash", powerFlash.value)
                    shader.setFloatUniform("resolution", size.width, size.height)
                    
                    renderEffect = android.graphics.RenderEffect.createRuntimeShaderEffect(
                        shader, "content"
                    ).asComposeRenderEffect()

                    if (shutdownProgress.value >= 1.0f) this.alpha = 0f
                }
        ) {
            content()
        }

        // Thermodynamic Glass Layer (Runs decoupled from the UI framework scaling parameters)
        if (phosphorAlpha.value > 0f) {
            Canvas(modifier = Modifier.fillMaxSize()) {
                val center = Offset(size.width / 2f, size.height / 2f)
                val remainingLineWidth = size.width * 0.45f * phosphorDotWidth.value

                if (remainingLineWidth > 2f) {
                    drawRect(
                        color = Color(0xFFD3E7FF).copy(alpha = phosphorAlpha.value * 0.65f),
                        topLeft = Offset(center.x - (remainingLineWidth / 2f), center.y - 1.5f),
                        size = Size(remainingLineWidth, 3f)
                    )
                }
                drawCircle(
                    color = Color.White.copy(alpha = phosphorAlpha.value),
                    radius = 8f + (5f * phosphorDotWidth.value),
                    center = center
                )
                drawCircle(
                    color = Color(0x7762FFF9).copy(alpha = phosphorAlpha.value * 0.4f),
                    radius = 28f * (1.4f - phosphorDotWidth.value),
                    center = center
                )
            }
        }
    }
}

