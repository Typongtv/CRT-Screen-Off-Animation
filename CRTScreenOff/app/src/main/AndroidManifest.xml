<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CRTScreenOff"
        tools:targetApi="tiramisu">

        <!-- 1. Configuration & Setup Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 2. Zero-Flicker Headless Trigger for Gestures / Open App / Shortcuts -->
        <activity
            android:name=".LockTriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.retro.crteffect.locktrigger"
            android:theme="@style/Theme.TransparentNoAnimation"
            android:icon="@mipmap/ic_lock_launcher"
            android:roundIcon="@mipmap/ic_lock_launcher_round"
            android:label="@string/shortcut_lock_label">
            <intent-filter>
                <action android:name="com.retro.crteffect.TRIGGER_LOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Enables Samsung Good Lock 'Home screen shortcuts' selection -->
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 2b. Launcher Entry for One Hand Operation + 'Start application' picker -->
        <activity-alias
            android:name=".LockTriggerLauncherActivity"
            android:targetActivity=".LockTriggerActivity"
            android:exported="true"
            android:icon="@mipmap/ic_lock_launcher"
            android:roundIcon="@mipmap/ic_lock_launcher_round"
            android:label="@string/shortcut_lock_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. Accessibility Service: Silent Frame Capture & Screen Lock Execution -->
        <service
            android:name=".CrtAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
        <!-- 4. Broadcast Receiver: Zero-Window silent trigger for automation / gestures -->
        <receiver
            android:name=".CrtLockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.retro.crteffect.TRIGGER_LOCK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
